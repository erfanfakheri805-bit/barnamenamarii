#:kivy 2.1.0
#:import dp kivy.metrics.dp
#:import sp kivy.metrics.sp
#:import FadeTransition kivy.uix.screenmanager.FadeTransition

# ---------------------------------------------------------------------------
#  Invisibility AR  -  theme: background #0F172A, accent #38BDF8, text #FFFFFF
#  All visible text is Persian and comes from app.t(...) (shaped + RTL ordered).
# ---------------------------------------------------------------------------

<Label>:
    font_name: app.font_name
    color: app.c_text

<RoundedCard>:
    canvas.before:
        Color:
            rgba: 0, 0, 0, 0.10 * self.shadow
        RoundedRectangle:
            pos: self.x - dp(3), self.y - dp(6)
            size: self.width + dp(6), self.height + dp(8)
            radius: [self.radius + dp(4)]
        Color:
            rgba: 0, 0, 0, 0.16 * self.shadow
        RoundedRectangle:
            pos: self.x - dp(1), self.y - dp(2)
            size: self.width + dp(2), self.height + dp(3)
            radius: [self.radius + dp(1)]
        Color:
            rgba: self.bg_color
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [self.radius]
        Color:
            rgba: self.border_color
        Line:
            rounded_rectangle: self.x, self.y, self.width, self.height, self.radius
            width: dp(1)

<IconButton>:
    canvas.before:
        Color:
            rgba: self.bg_color
        Ellipse:
            pos: self.pos
            size: self.size
        Color:
            rgba: self.ring_color
        Line:
            ellipse: self.x, self.y, self.width, self.height
            width: dp(1)
    Image:
        source: root.source
        size_hint: None, None
        size: root.icon_px * root.scale, root.icon_px * root.scale
        pos_hint: {'center_x': .5, 'center_y': .5}
        mipmap: True
        opacity: 0.35 if root.disabled else 1

<ChipButton>:
    size_hint_y: None
    height: dp(44)
    font_size: sp(15)
    halign: 'center'
    valign: 'middle'
    text_size: self.size
    canvas.before:
        Color:
            rgba: (0.24, 0.33, 0.46, 1) if self.state == 'down' else (0.16, 0.22, 0.32, 1)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(14)]

<AccentButton>:
    font_size: sp(16)
    halign: 'center'
    valign: 'middle'
    text_size: self.size
    color: 0.06, 0.09, 0.16, 1
    canvas.before:
        Color:
            rgba: (0.18, 0.62, 0.86, 1) if self.state == 'down' else (0.22, 0.74, 0.97, 1)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(22)]

<RecordButton>:
    canvas:
        PushMatrix
        Scale:
            x: self.scale
            y: self.scale
            origin: self.center
        Color:
            rgba: app.c_rec[0], app.c_rec[1], app.c_rec[2], 0.55 * (1 - self.ring) * self.rec
        Line:
            circle: self.center_x, self.center_y, self.width / 2 + dp(14) * self.ring
            width: dp(2)
        Color:
            rgba: 1, 1, 1, 0.96
        Line:
            circle: self.center_x, self.center_y, self.width / 2 - dp(3)
            width: dp(3)
        Color:
            rgba: app.c_rec
        RoundedRectangle:
            pos: self.center_x - self.inner / 2, self.center_y - self.inner / 2
            size: self.inner, self.inner
            radius: [self.inner / 2 * (1 - 0.7 * self.rec)]
        PopMatrix

<LoadingRing>:
    canvas:
        Color:
            rgba: 1, 1, 1, 0.08
        Line:
            circle: self.center_x, self.center_y, self.width / 2 - dp(4)
            width: dp(3)
        Color:
            rgba: app.c_accent
        Line:
            circle: self.center_x, self.center_y, self.width / 2 - dp(4), self.angle, self.angle + 110
            width: dp(3.5)
            cap: 'round'

# ---------------------------------------------------------------------------
<LoadingScreen>:
    name: 'loading'
    canvas.before:
        Color:
            rgba: app.c_bg
        Rectangle:
            pos: self.pos
            size: self.size
    FloatLayout:
        LoadingRing:
            id: ring
            size_hint: None, None
            size: dp(136), dp(136)
            pos_hint: {'center_x': .5, 'center_y': .60}
        Image:
            source: app.asset('icon.png')
            size_hint: None, None
            size: dp(84), dp(84)
            pos_hint: {'center_x': .5, 'center_y': .60}
            mipmap: True
        Label:
            text: app.t('app_title')
            font_name: app.font_bold
            font_size: sp(32)
            size_hint: 1, None
            height: dp(48)
            pos_hint: {'center_x': .5, 'center_y': .46}
        Label:
            text: 'Invisibility AR'
            font_size: sp(14)
            color: app.c_muted
            size_hint: 1, None
            height: dp(24)
            pos_hint: {'center_x': .5, 'center_y': .415}
        Label:
            text: app.status_text
            font_size: sp(15)
            color: app.c_accent if not app.error_mode else app.c_text
            halign: 'center'
            valign: 'middle'
            text_size: self.width - dp(48), None
            size_hint: 1, None
            height: self.texture_size[1] + dp(8)
            pos_hint: {'center_x': .5, 'center_y': .32}
        BoxLayout:
            size_hint: None, None
            size: min(root.width - dp(40), dp(320)), dp(48)
            pos_hint: {'center_x': .5, 'center_y': .2}
            spacing: dp(12)
            opacity: 1 if app.error_mode else 0
            disabled: not app.error_mode
            ChipButton:
                text: app.t('open_settings')
                pos_hint: {'center_y': .5}
                on_release: app.open_app_settings()
            ChipButton:
                text: app.t('retry')
                pos_hint: {'center_y': .5}
                on_release: app.retry_boot()

# ---------------------------------------------------------------------------
<CameraScreen>:
    name: 'camera'
    canvas.before:
        Color:
            rgba: app.c_bg
        Rectangle:
            pos: self.pos
            size: self.size
    FloatLayout:
        PreviewView:
            id: preview
            size_hint: 1, 1

        # ---- top bar (RTL: hand state on the right, tools on the left) -------
        IconButton:
            id: gear_btn
            source: app.asset('icons', 'settings.png')
            size_hint: None, None
            size: dp(46), dp(46)
            pos_hint: {'x': .04, 'top': .985}
            bg_color: 0.06, 0.09, 0.16, 0.74
            ring_color: 1, 1, 1, 0.12
            icon_px: dp(24)
            on_release: app.toggle_sheet()
        RoundedCard:
            id: fps_chip
            size_hint: None, None
            size: dp(136), dp(34)
            x: gear_btn.right + dp(8)
            top: gear_btn.top - dp(6)
            radius: dp(17)
            bg_color: 0.06, 0.09, 0.16, 0.66
            Label:
                text: app.fps_text
                font_size: sp(12.5)
                color: 1, 1, 1, 0.92
        StateChip:
            id: state_chip
            size_hint: None, None
            size: dp(160), dp(46)
            pos_hint: {'right': .96, 'top': .985}
            radius: dp(23)
            bg_color: app.state_color
            border_color: 1, 1, 1, 0.12
            on_release: app.toggle_manual()
            BoxLayout:
                padding: dp(16), dp(7), dp(12), dp(7)
                spacing: dp(8)
                Label:
                    text: app.state_text
                    font_name: app.font_bold
                    font_size: sp(17)
                    halign: 'right'
                    valign: 'middle'
                    text_size: self.size
                    color: app.state_fg
                Image:
                    source: app.state_icon
                    size_hint: None, 1
                    width: dp(30)
                    mipmap: True

        # ---- hint chip --------------------------------------------------------
        RoundedCard:
            id: hint_chip
            size_hint: None, None
            size: min(root.width - dp(32), dp(360)), hint_label.texture_size[1] + dp(22)
            pos_hint: {'center_x': .5, 'top': .915}
            radius: dp(16)
            bg_color: 0.06, 0.09, 0.16, 0.72
            opacity: 1 if app.hint_text else 0
            Label:
                id: hint_label
                text: app.hint_text
                font_size: sp(13.5)
                halign: 'center'
                valign: 'middle'
                text_size: self.width - dp(24), None
                size_hint: 1, 1

        # ---- recording timer --------------------------------------------------
        RoundedCard:
            id: timer_chip
            size_hint: None, None
            size: dp(120), dp(38)
            pos_hint: {'center_x': .5}
            y: dock.top + dp(12)
            radius: dp(19)
            bg_color: app.c_rec[0], app.c_rec[1], app.c_rec[2], 0.94
            opacity: 1 if app.recording else 0
            Label:
                text: app.timer_text
                font_name: app.font_bold
                font_size: sp(16)

        # ---- toast ------------------------------------------------------------
        RoundedCard:
            id: toast
            size_hint: None, None
            size: min(root.width - dp(40), dp(340)), toast_label.texture_size[1] + dp(26)
            pos_hint: {'center_x': .5}
            y: dock.top + dp(62)
            radius: dp(16)
            bg_color: 0.12, 0.16, 0.23, 0.97
            border_color: 1, 1, 1, 0.10
            opacity: app.toast_opacity
            Label:
                id: toast_label
                text: app.toast_text
                font_size: sp(14.5)
                halign: 'center'
                valign: 'middle'
                text_size: self.width - dp(28), None
                size_hint: 1, 1

        # ---- first-run orientation confirmation -------------------------------
        RoundedCard:
            id: orient_card
            size_hint: None, None
            size: min(root.width - dp(28), dp(380)), dp(132)
            pos_hint: {'center_x': .5}
            y: dock.top + dp(14)
            radius: dp(24)
            bg_color: 0.07, 0.11, 0.19, 0.97
            border_color: app.c_accent[0], app.c_accent[1], app.c_accent[2], 0.45
            opacity: app.orient_card_open * (1 - app.sheet_open)
            disabled: app.orient_card_open < 0.5 or app.sheet_open > 0.5
            BoxLayout:
                orientation: 'vertical'
                padding: dp(16)
                spacing: dp(10)
                Label:
                    text: app.t('orient_q')
                    font_name: app.font_bold
                    font_size: sp(16)
                    halign: 'right'
                    valign: 'middle'
                    text_size: self.size
                BoxLayout:
                    spacing: dp(10)
                    size_hint_y: None
                    height: dp(44)
                    ChipButton:
                        text: app.t('orient_no')
                        on_release: app.orient_next()
                    ChipButton:
                        text: app.t('orient_yes')
                        on_release: app.orient_ok()

        # ---- manual toggle (only when no hand model could be loaded) ---------
        AccentButton:
            id: manual_btn
            size_hint: None, None
            size: dp(150), dp(44)
            x: dock.x + dp(4)
            y: dock.top + dp(12)
            text: app.manual_text
            font_name: app.font_bold
            opacity: 1 if app.classic_mode else 0
            disabled: not app.classic_mode
            on_release: app.toggle_manual()

        # ---- orientation sheet ------------------------------------------------
        RoundedCard:
            id: sheet
            size_hint: None, None
            size: min(root.width - dp(28), dp(380)), dp(348)
            pos_hint: {'center_x': .5}
            y: dock.top + dp(14)
            radius: dp(24)
            bg_color: 0.07, 0.11, 0.19, 0.97
            border_color: 1, 1, 1, 0.10
            opacity: app.sheet_open
            disabled: app.sheet_open < 0.5
            BoxLayout:
                orientation: 'vertical'
                padding: dp(16)
                spacing: dp(10)
                Label:
                    text: app.t('orient_title')
                    font_name: app.font_bold
                    font_size: sp(17)
                    halign: 'right'
                    valign: 'middle'
                    text_size: self.size
                    size_hint_y: None
                    height: dp(30)
                ChipButton:
                    text: app.t('orient_rotate')
                    on_release: app.orient_rotate()
                ChipButton:
                    text: app.t('orient_mirror')
                    on_release: app.orient_mirror()
                ChipButton:
                    text: app.t('orient_flip')
                    on_release: app.orient_flip()
                ChipButton:
                    text: app.t('close')
                    on_release: app.toggle_sheet()
                Label:
                    text: app.diag_text
                    font_name: 'Roboto'
                    font_size: sp(10)
                    color: app.c_muted
                    halign: 'left'
                    valign: 'top'
                    text_size: self.width, None
                    size_hint_y: None
                    height: self.texture_size[1] + dp(4)

        # ---- bottom dock ------------------------------------------------------
        RoundedCard:
            id: dock
            size_hint: None, None
            size: min(root.width - dp(28), dp(380)), dp(94)
            pos_hint: {'center_x': .5}
            y: dp(20)
            radius: dp(32)
            bg_color: 0.06, 0.09, 0.16, 0.80
            border_color: 1, 1, 1, 0.09
            IconButton:
                source: app.asset('icons', 'reset.png')
                size_hint: None, None
                size: dp(56), dp(56)
                pos_hint: {'center_y': .5}
                x: dock.x + dp(24)
                bg_color: 1, 1, 1, 0.07
                ring_color: 1, 1, 1, 0.10
                icon_px: dp(28)
                disabled: app.busy
                on_release: app.reset_background()
            RecordButton:
                id: rec_btn
                size_hint: None, None
                size: dp(74), dp(74)
                pos_hint: {'center_x': .5, 'center_y': .5}
                disabled: app.busy
                on_release: app.toggle_record()
            IconButton:
                source: app.asset('icons', 'flip.png')
                size_hint: None, None
                size: dp(56), dp(56)
                pos_hint: {'center_y': .5}
                right: dock.right - dp(24)
                bg_color: 1, 1, 1, 0.07
                ring_color: 1, 1, 1, 0.10
                icon_px: dp(28)
                disabled: app.recording or app.busy
                on_release: app.flip_camera()

# ---------------------------------------------------------------------------
ScreenManager:
    transition: FadeTransition(duration=0.45)
    LoadingScreen:
    CameraScreen:
